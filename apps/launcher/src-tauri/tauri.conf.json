{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jouzu Desktop",
  "version": "../package.json",
  "identifier": "ai.shisa.jouzu.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist",
    "additionalWatchFolders": [
      "../../../packaging/launcher"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "Jouzu",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "create": false,
        "decorations": false,
        "maximizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Shisa, Inc.",
    "copyright": "Copyright © Shisa, Inc.",
    "resources": {
      "../host/target/package/jouzu-host.exe": "host/jouzu-host.exe",
      "../dist/": "dist/"
    },
    "windows": {
      "nsis": {
        "template": "../../../packaging/launcher/installer.nsi",
        "installerHooks": "../../../packaging/launcher/desktop-installer-hooks.nsh",
        "languages": [
          "English",
          "Japanese",
          "SimpChinese",
          "TradChinese"
        ],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFMUY0RjBGOTc4Q0UzNDIKUldSQzQ0eVhEMDhmUHUxUHZXNWZFNmdkZXpHY0JzWUJQNFZlNFY3SUJJNFlaYXNBMlBsQVZ6c1IK",
      "endpoints": [
        "https://github.com/shisa-ai/jouzu-desktop/releases/download/desktop-update/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}






